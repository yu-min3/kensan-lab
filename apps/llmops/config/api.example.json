    {
      "app": "konro",
      "role": "eval",
      "target_id": "local-runtime",
      "client_id": "runtime-konro-eval",
      "base_url": "https://runtime.example.test",
      "token_url": "https://id.localhost:19443/realms/llmops/protocol/openid-connect/token",
      "client_secret_file": "/run/llmops/secrets/runtime-konro-eval.secret",
      "ca_file": "/run/llmops/ca.pem"
