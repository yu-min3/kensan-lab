{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://llmops.example/contracts/v1/adapter-request.schema.json",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "protocol_version": {
      "type": "string",
      "enum": [
        "1"
      ]
    },
    "request_id": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]{0,127}$"
    },
    "operation": {
      "type": "string",
      "enum": [
        "prepare",
        "grade"
      ]
    },
    "domain_schema_version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "payload": {
      "type": "object"
    }
  },
  "required": [
    "protocol_version",
    "request_id",
    "operation",
    "domain_schema_version",
    "payload"
  ]
}
