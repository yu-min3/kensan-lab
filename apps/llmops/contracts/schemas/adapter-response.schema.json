{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://llmops.example/contracts/v1/adapter-response.schema.json",
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "protocol_version": {
          "type": "string",
          "enum": [
            "1"
          ]
        },
        "request_id": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]{0,127}$"
        },
        "result": {
          "type": "object"
        }
      },
      "required": [
        "protocol_version",
        "request_id",
        "result"
      ]
    },
    {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "protocol_version": {
          "type": "string",
          "enum": [
            "1"
          ]
        },
        "request_id": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]{0,127}$"
        },
        "error": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "code": {
              "type": "string",
              "enum": [
                "invalid_input",
                "unsupported_version",
                "processing_failed"
              ]
            },
            "message": {
              "type": "string",
              "minLength": 1,
              "maxLength": 512
            }
          },
          "required": [
            "code",
            "message"
          ]
        }
      },
      "required": [
        "protocol_version",
        "request_id",
        "error"
      ]
    }
  ]
}
