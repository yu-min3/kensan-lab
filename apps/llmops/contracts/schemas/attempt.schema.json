{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://llmops.example/contracts/v1/attempt.schema.json",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "type": "string",
      "enum": [
        "1"
      ]
    },
    "app_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{0,62}$"
    },
    "run_id": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]{0,127}$"
    },
    "attempt_id": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]{0,127}$"
    },
    "runtime_job_id": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]{0,127}$"
    },
    "state": {
      "type": "string",
      "enum": [
        "queued",
        "running",
        "waiting",
        "succeeded",
        "failed",
        "cancelled"
      ]
    },
    "reason": {
      "type": "string",
      "minLength": 0,
      "maxLength": 256
    },
    "input": {
      "$ref": "object-ref.schema.json"
    },
    "output": {
      "$ref": "object-ref.schema.json"
    },
    "model": {
      "type": [
        "string",
        "null"
      ]
    },
    "usage": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "input_tokens": {
              "type": "integer",
              "minimum": 0
            },
            "output_tokens": {
              "type": "integer",
              "minimum": 0
            }
          },
          "required": [
            "input_tokens",
            "output_tokens"
          ]
        }
      ]
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "schema_version",
    "app_id",
    "run_id",
    "attempt_id",
    "state",
    "input",
    "model",
    "usage",
    "created_at"
  ]
}
