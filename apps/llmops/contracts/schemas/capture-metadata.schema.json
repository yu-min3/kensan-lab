{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://llmops.example/contracts/v1/capture-metadata.schema.json",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "capture_key": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]{0,127}$"
    },
    "mime": {
      "type": "string",
      "enum": [
        "text/html",
        "text/plain",
        "text/markdown",
        "image/jpeg",
        "image/png",
        "application/pdf"
      ]
    },
    "source_uri": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2048
    },
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "app_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{0,62}$"
    }
  },
  "required": [
    "capture_key",
    "mime",
    "sha256"
  ]
}
