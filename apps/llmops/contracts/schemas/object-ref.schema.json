{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://llmops.example/contracts/v1/object-ref.schema.json",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "object_id": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]{0,127}$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "size": {
      "type": "integer",
      "minimum": 0
    },
    "app_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{0,62}$"
    }
  },
  "required": [
    "object_id",
    "sha256",
    "size",
    "app_id"
  ]
}
