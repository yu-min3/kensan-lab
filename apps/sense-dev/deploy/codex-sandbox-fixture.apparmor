# Credential-free, offline fixture only. Not approved for the controller.
abi <abi/4.0>,
include <tunables/global>
profile sense_codex_fixture /opt/kensan-dev/sandbox-fixture/bwrap flags=(attach_disconnected) {
  allow capability sys_admin sys_chroot setuid setgid setpcap net_admin mknod,
  allow userns,
  allow file rwlkm /{**,},
  allow network,
  allow unix,
  allow ptrace,
  allow signal,
  allow mqueue,
  allow io_uring,
  allow mount,
  allow umount,
  allow pivot_root,
  allow dbus,
  allow ix /opt/codex/bin/codex,
  allow ix /usr/local/bin/sense-dev-worker,
  allow px /opt/codex/codex-resources/bwrap -> sense_codex_fixture//&sense_fixture_nested,
  allow px /usr/bin/** -> sense_codex_fixture//&sense_fixture_tool,
  allow px /bin/** -> sense_codex_fixture//&sense_fixture_tool,
}
profile sense_fixture_nested flags=(attach_disconnected) {
  allow capability sys_admin sys_chroot setuid setgid setpcap net_admin mknod,
  allow userns,
  allow file rwlkm /{**,},
  allow network,
  allow unix,
  allow ptrace,
  allow signal,
  allow mqueue,
  allow io_uring,
  allow mount,
  allow umount,
  allow pivot_root,
  allow dbus,
  allow px /** -> sense_fixture_nested//&sense_fixture_tool,
}
profile sense_fixture_tool flags=(attach_disconnected) {
  # Tools may not access provider configuration or authentication material.
  audit deny /agent-auth{,/**} rwlkm,
  allow file rwlkm /{**,},
  allow network,
  allow unix,
  allow ptrace,
  allow signal,
  allow mqueue,
  allow io_uring,
  allow dbus,
  audit deny capability,
  audit deny userns,
  allow pix /** -> &sense_fixture_tool,
}
