[Unit]
Description=Kensan autonomous development controller (private stage)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=kensan-dev
Group=kensan-dev
StateDirectory=kensan-dev
StateDirectoryMode=0700
WorkingDirectory=/opt/kensan-dev/source
ExecStart=/opt/kensan-dev/bin/sense-dev -listen 127.0.0.1:8787 -data /var/lib/kensan-dev -admin-token-file /var/lib/kensan-dev/admin-token -tokens-css /opt/kensan-dev/source/packages/design-tokens/tokens.css -mock-worker
Restart=on-failure
RestartSec=5
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/var/lib/kensan-dev
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6

[Install]
WantedBy=multi-user.target
